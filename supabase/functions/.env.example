# Settings (secrets) for the Supabase Edge Functions.
#
# Copy this file to .env in the same folder and fill in your values. .env is ignored by git, so
# your keys never reach GitHub. This .env.example template is committed; keep it free of real keys.
#
# Live site: add the same names in Supabase → Edge Functions → Secrets, or upload this file:
#   npx supabase secrets set --env-file supabase/functions/.env --project-ref axolgiobcbepqnymasgz
# Local testing: npx supabase functions serve reads supabase/functions/.env automatically.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically. Don't add them.

# ---- MyFatoorah payments (create-payment, verify-payment) ----
# Your MyFatoorah API token. Use the test/demo token first.
MYFATOORAH_API_KEY=
# https://apitest.myfatoorah.com (test, default) or https://api.myfatoorah.com (live, Kuwait)
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
# The public site address. MyFatoorah sends members back here after paying.
SITE_URL=https://gym-y16a.vercel.app/

# ---- Write with AI (write-with-ai) ----
OPENROUTER_API_KEY=
# Optional. OpenRouter model id. Leave empty for the default.
OPENROUTER_MODEL=

# ---- All functions ----
# Optional. Comma-separated site addresses allowed to call the functions. Empty = any site.
ALLOWED_ORIGINS=https://gym-y16a.vercel.app
